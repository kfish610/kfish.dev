{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run dev",
      "name": "Run development server",
      "request": "launch",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "type": "node-terminal"
    }
  ]
}
