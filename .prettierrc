{
  "singleQuote": true,
  "printWidth": 100,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-svelte",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^\\$(app|env|lib|service-worker)(/.*)?$",
    "^~icons/",
    "",
    "^[.]"
  ],
  "tailwindStylesheet": "./src/routes/layout.css"
}
